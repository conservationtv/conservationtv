{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "avoid",
  "printWidth": 120,
  "bracketSpacing": true,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "none",
  "bracketSameLine": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/bin/**",
    "**/.cloudflare/**",
    "**/.wrangler/**",
    "**/node_modules/**",
    "target/**",
    "tools/**",
    "apps/controlplane/gatekeeper/openapi.json",
    "apps/controlplane/gatekeeper/snapshots/**",
    "apps/controlplane/sdk/src/generated/**",
    "apps/controlplane/sdk/src/versions/**",
    "apps/controlplane/cli/src/generated/**",
    "apps/controlplane/infrastructure/sdks/**",
    "apps/controlplane/gatekeeper/drizzle/**",
    "apps/agent/core/contracts/**",
    "apps/agent/sdk/src/generated/**",
    "apps/agent/sdk/src/versions/**",
    "apps/agent/cli/src/generated/**",
    "packages/mediamtx/spec/**",
    "packages/mediamtx/src/generated/**",
    "packages/ui/src/components/**",
    "packages/ui/src/hooks/**",
    "packages/ui/src/lib/**",
    "apps/studio/web/src/components/blocks/**",
    "apps/studio/web/src/components/app/theme-provider.tsx"
  ],
  "sortPackageJson": false
}
