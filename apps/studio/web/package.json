{
  "name": "@conservationtv/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @conservationtv/shows bundle && react-router dev",
    "dev:staging": "pnpm --filter @conservationtv/shows bundle && react-router dev",
    "build": "react-router typegen && tsc -b && pnpm --filter @conservationtv/shows bundle && react-router build",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "react-router typegen && tsc -b",
    "preview": "vite preview --outDir build/client"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@better-fetch/fetch": "1.3.2",
    "@conservationtv/shows": "workspace:*",
    "@conservationtv/studio-sdk": "workspace:*",
    "@conservationtv/ui": "workspace:*",
    "@moq/watch": "0.6.6",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "13.3.0",
    "@strangecyan/vignette": "2.1.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.2",
    "@xstate/store": "4.3.0",
    "@xstate/store-react": "2.1.0",
    "better-auth": "catalog:",
    "input-otp": "catalog:",
    "isbot": "^5",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query-devtools": "5.104.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "oxc-transform-react": "0.152.0",
    "typescript": "catalog:",
    "vite": "^8"
  }
}
