{
  "name": "@conservationtv/studio-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Commands generated from the studio API, mounted by the conservation.tv CLI (apps/cli).",
  "exports": {
    ".": "./src/generated/incur-builder.gen.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "generate": "openapi-ts --file openapi-ts.config.ts"
  },
  "dependencies": {
    "@conservationtv/studio-sdk": "workspace:*",
    "@conservationtv/versioned-api": "workspace:*",
    "incur": "0.6.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@conservationtv/studio-api": "workspace:*",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "24.10.1",
    "typescript": "6.0.3"
  }
}
