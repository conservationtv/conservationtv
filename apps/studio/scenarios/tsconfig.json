{
  // Run from source by tsx; this project only type-checks.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Collection", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // The API's show resolver is imported from its source, and what it reaches includes components (packages/shows).
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true
  },
  "include": ["src/**/*.ts"]
}
