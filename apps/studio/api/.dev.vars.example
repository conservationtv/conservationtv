# Copy to .dev.vars for `pnpm dev`. Better Auth signs cookies and tokens with this; generate 32 random bytes:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=REPLACE_WITH_GENERATED_SECRET

# The master key for encrypted columns and blind indexes: 32 random bytes, generated the same way.
FIELD_KEY=REPLACE_WITH_GENERATED_KEY

# Optional: lease devices' endpoints from a gatekeeper, on the relay IROH_RELAY_URL names. Locally, that is the
# controlplane's local environment (apps/controlplane/gatekeeper: `pnpm local:up` and `pnpm dev`), whose consumer
# token this is:
# GATEKEEPER_URL=http://localhost:5176
# GATEKEEPER_TOKEN=local-consumer-token
# IROH_RELAY_URL=http://localhost:3340
# Or staging's, with the token from 1Password (or `pulumi stack output gatekeeperConsumerToken --show-secrets`):
# GATEKEEPER_URL=https://gatekeeper.staging.conservation.tv
# GATEKEEPER_TOKEN=…
# IROH_RELAY_URL=https://iroh.ldn1.nodes.staging.conservation.tv/

# Optional overrides of the checked-in development defaults.
# APP_URL=http://localhost:5175
# WEB_ORIGINS=http://localhost:5173
# IROH_RELAY_URL=https://euc1-1.relay.n0.iroh.link./
# OTP_DELIVERY=log
