# Copy to .dev.vars for `pnpm dev`. Better Auth signs cookies and tokens with this; generate 32 random bytes:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=REPLACE_WITH_GENERATED_SECRET

# The master key for encrypted columns and blind indexes: 32 random bytes, generated the same way.
FIELD_KEY=REPLACE_WITH_GENERATED_KEY

# Optional: lease devices' endpoints from a controlplane gatekeeper. `pnpm dev:controlplane` uses the local one
# (apps/controlplane/gatekeeper: `pnpm local:up` and `pnpm dev`) and `pnpm dev:staging` staging's; each sets
# GATEKEEPER_URL and IROH_RELAY_URL itself, and reads secrets from .dev.vars.<mode> instead of this file. Copy this
# file to .dev.vars.controlplane or .dev.vars.staging, then add that environment's consumer token:
# GATEKEEPER_TOKEN=local-consumer-token                  (.dev.vars.controlplane)
# GATEKEEPER_TOKEN=…                                     (.dev.vars.staging, from 1Password: gatekeeper_staging_consumer_token)

# Text bindings are not read from this file: override the checked-in development defaults from the environment,
# e.g. `APP_URL=… pnpm dev`.
# APP_URL=http://localhost:5175
# WEB_ORIGINS=http://localhost:5173
# IROH_RELAY_URL=https://euc1-1.relay.n0.iroh.link./
# OTP_DELIVERY=log
