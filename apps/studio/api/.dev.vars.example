# Copy to .dev.vars for `pnpm dev`. Better Auth signs cookies and tokens with this; generate 32 random bytes:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=REPLACE_WITH_GENERATED_SECRET

# The master key for encrypted columns and blind indexes: 32 random bytes, generated the same way.
FIELD_KEY=REPLACE_WITH_GENERATED_KEY

# The consumer token of the controlplane gatekeeper, which names the relays and admits devices to them. `pnpm dev` uses
# the local one (apps/controlplane/gatekeeper: `pnpm local:up` and `pnpm dev`). `pnpm dev:staging` uses staging's, and
# reads secrets from .dev.vars.staging instead of this file: copy this file there, with staging's token from
# 1Password (gatekeeper_staging_consumer_token).
GATEKEEPER_TOKEN=local-consumer-token

# Optional: sign tokens for MediaMTX gateways, which verify them against `GET /gateway-keys`. A keyring of ES256 JWKs,
# with the private `d`, on one line; generate one key with:
# node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign']).then(k=>crypto.subtle.exportKey('jwk',k.privateKey)).then(({kty,crv,x,y,d})=>console.log(JSON.stringify({active_kid:'1',keys:[{kty,crv,x,y,d,alg:'ES256',kid:'1'}]})))"
# GATEWAY_SIGNING_KEYS={"active_kid":"1","keys":[…]}

# Optional: give MediaMTX gateways hostnames under a domain you control, `<gateway>.<organisation>.<domain>`, pointed
# at the agent running each, with Let's Encrypt certificates for them. Needs the domain's Cloudflare zone and a token
# that may edit its DNS records, and an ACME account key: one ES256 JWK with the private `d`, generated with:
# node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign']).then(k=>crypto.subtle.exportKey('jwk',k.privateKey)).then(({kty,crv,x,y,d})=>console.log(JSON.stringify({kty,crv,x,y,d})))"
# The domain and zone are text bindings, set from the environment; the directory defaults to Let's Encrypt's staging
# environment, whose certificates browsers do not trust: deployments set the production directory.
# CLOUDFLARE_API_TOKEN=…
# ACME_ACCOUNT_KEY={"kty":"EC","crv":"P-256",…}

# Text bindings are not read from this file: override the checked-in development defaults from the environment,
# e.g. `APP_URL=… pnpm dev`.
# APP_URL=http://localhost:5175
# WEB_ORIGINS=http://localhost:5173
# GATEKEEPER_URL=http://localhost:5176
# OTP_DELIVERY=log
# GATEWAY_DOMAIN=conservationtv.net
# CLOUDFLARE_ZONE_ID=…
# ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
