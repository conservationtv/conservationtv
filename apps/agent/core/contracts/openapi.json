{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent API",
    "description": "The conservation.tv agent API, served by the agent itself.",
    "version": "0.1.0"
  },
  "components": {
    "responses": {
      "InvalidRequest": {
        "description": "The request is invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "error_description": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "error_description"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "System": {
        "type": "object",
        "properties": {
          "heartbeat": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "object",
                "properties": {
                  "running": {
                    "type": "boolean"
                  },
                  "intervalMs": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "message": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "beats": {
                    "type": "number"
                  },
                  "lastBeatAt": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "running",
                  "intervalMs",
                  "message",
                  "beats",
                  "lastBeatAt"
                ]
              },
              "apply": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "applying"
                      },
                      "revision": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "state",
                      "revision"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "applied"
                      },
                      "revision": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "state",
                      "revision"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "const": "failed"
                      },
                      "revision": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "error": {
                        "type": "string"
                      },
                      "attempt": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "state",
                      "revision",
                      "error",
                      "attempt"
                    ]
                  }
                ]
              }
            },
            "required": [
              "runtime",
              "apply"
            ]
          }
        },
        "required": [
          "heartbeat"
        ]
      }
    }
  },
  "paths": {
    "/status": {
      "get": {
        "operationId": "status.get",
        "x-operation-version": 1,
        "summary": "Read the agent status",
        "description": "Whether the agent is up and serving requests.",
        "responses": {
          "200": {
            "description": "The agent is serving requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "412": {
            "description": "The selected operation version is not served",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-operation-versions": [
          1
        ]
      }
    },
    "/system": {
      "get": {
        "operationId": "system.get",
        "x-operation-version": 1,
        "summary": "Read the agent's runtimes",
        "description": "Each runtime's live status, and whether it has accepted its latest spec. Live, never stored: after a restart it is rebuilt from the runtimes.",
        "responses": {
          "200": {
            "description": "Every runtime's status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/System"
                }
              }
            }
          },
          "412": {
            "description": "The selected operation version is not served",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-operation-versions": [
          1
        ]
      }
    }
  },
