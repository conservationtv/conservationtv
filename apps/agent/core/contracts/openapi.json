        ]
      }
    },
    "/system": {
      "get": {
        "operationId": "system.get",
        "x-operation-version": 1,
        "summary": "Read the agent's runtimes",
        "description": "Each runtime's live status, and whether it has accepted its latest spec. Live, never stored: after a restart it is rebuilt from the runtimes.",
        "responses": {
          "200": {
            "description": "Every runtime's status",
            "content": {
              "application/json": {
                "schema": {
