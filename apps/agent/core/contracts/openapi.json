        ]
      }
    },
    "/system/spec": {
      "get": {
        "operationId": "system.spec",
        "x-operation-version": 1,
        "summary": "Read the agent's currently defined spec",
        "responses": {
          "200": {
            "description": "The current system specification",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "machine": {
                      "type": "object",
                      "properties": {
                        "intervalMs": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "intervalMs"
                      ]
                    },
                    "mediamtx": {
                      "type": "object",
                      "properties": {
                        "binary": {
                          "type": "object",
                          "properties": {
                            "version": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string",
                              "const": "mediamtx"
                            },
                            "artifacts": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "object",
                                "properties": {
                                  "url": {
                                    "type": "string"
                                  },
                                  "checksum": {
                                    "type": "string"
                                  },
                                  "format": {
                                    "type": "string"
                                  },
                                  "path": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "url",
                                  "checksum",
                                  "format"
                                ]
                              }
                            }
                          },
                          "required": [
                            "version",
                            "name",
                            "artifacts"
                          ]
                        },
                        "paths": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "exposureId": {
                                "type": "string"
                              },
                              "rendition": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "name",
                              "exposureId"
                            ]
                          }
                        },
                        "metricsIntervalMs": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "binary",
                        "paths",
                        "metricsIntervalMs"
                      ]
                    }
                  }
                }
              }
            }
          },
          "412": {
            "description": "The selected operation version is not served",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-operation-versions": [
          1
