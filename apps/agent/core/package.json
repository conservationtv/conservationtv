{
  "name": "@conservationtv/agent-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./openapi.json": "./contracts/openapi.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "generate": "api-contracts generate",
    "snapshot": "api-contracts snapshot",
    "check:release": "api-contracts check-release",
    "check:snapshot": "api-contracts check-snapshot",
    "snapshot:required": "api-contracts check-snapshot --required",
    "ci:contracts": "api-contracts ci"
  },
  "dependencies": {
    "@conservationtv/converge": "workspace:*",
    "@conservationtv/mediamtx": "workspace:*",
    "@conservationtv/reports": "workspace:*",
    "@conservationtv/store": "workspace:*",
    "@conservationtv/studio-sdk": "workspace:*",
    "@conservationtv/versioned-api": "workspace:*",
    "@hono/node-server": "2.1.4",
    "@hono/standard-validator": "0.4.0",
    "@moq/net": "0.4.4",
    "@number0/iroh": "catalog:",
    "@strangecyan/iroh-http-node": "catalog:",
    "hono": "4.13.8",
    "hono-openapi": "1.3.3",
    "jose": "6.2.12",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
