{
  "name": "@conservationtv/agent-desktop",
  "productName": "Conservation.tv Agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs the agent from a desktop app, set up from a ctvagent:// link in the studio: no Docker, no service.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build.ts",
    "package": "node scripts/build.ts && electron-builder --config electron-builder.yml",
    "package:dir": "node scripts/build.ts && electron-builder --config electron-builder.yml --dir",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json"
  },
  "dependencies": {
    "@number0/iroh": "catalog:"
  },
  "devDependencies": {
    "@conservationtv/agent-api": "workspace:*",
    "@conservationtv/ui": "workspace:*",
    "@logtape/logtape": "2.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4",
    "@types/node": "24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "oxc-transform-react": "0.152.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "7.8.2",
    "typescript": "catalog:",
    "vite": "^8",
    "zod": "catalog:"
  }
}
