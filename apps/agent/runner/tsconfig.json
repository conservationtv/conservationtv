{
  // Run through tsx, and bundled by esbuild for the image; this project only type-checks.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
