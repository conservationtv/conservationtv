{
  "name": "@conservationtv/controlplane-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A generated version-aware CLI for the conservation.stream control plane (gatekeeper).",
  "bin": {
    "gatekeeper": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "cli": "tsx src/index.ts",
    "generate": "openapi-ts --file openapi-ts.config.ts"
  },
  "dependencies": {
    "@conservationtv/controlplane-sdk": "workspace:*",
    "incur": "0.6.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@conservationtv/gatekeeper": "workspace:*",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
