{
  "openapi": "3.1.0",
  "info": {
    "title": "Gatekeeper",
    "description": "The conservation.stream control plane: a relay capability broker that exchanges consumer-signed grant assertions for MoQ and Iroh relay credentials.",
    "version": "0.1.0"
  },
  "components": {
    "responses": {
      "InvalidRequest": {
        "description": "The request is invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "error_description": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "error_description"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "Grant": {
        "type": "object",
        "properties": {
          "grant_id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "issued_at": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "credentials": {
            "type": "object",
            "properties": {
              "moq": {
                "type": "object",
                "properties": {
                  "root": {
                    "type": "string"
                  },
                  "token": {
                    "type": "string"
                  },
                  "expires_at": {
                    "type": "string"
                  }
                },
                "required": [
                  "root",
                  "token",
                  "expires_at"
                ]
              },
              "iroh": {
                "type": "object",
                "properties": {
                  "endpoint_id": {
                    "type": "string"
                  },
                  "lease_id": {
                    "type": "string"
                  },
                  "expires_at": {
                    "type": "string"
                  }
                },
                "required": [
                  "endpoint_id",
                  "lease_id",
                  "expires_at"
                ]
              }
            }
          }
        },
        "required": [
          "grant_id",
          "subject",
          "issued_at",
          "expires_at",
          "credentials"
        ]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health.get",
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "The server is ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/grants/exchange": {
      "post": {
        "operationId": "grants.exchange",
        "x-operation-version": 1,
        "summary": "Exchange a grant assertion",
        "description": "Exchanges a consumer-signed `relay-grant+jwt` assertion for relay credentials: a MoQ capability token and/or an Iroh endpoint lease. Every security-relevant field lives inside the signed assertion; each assertion can be exchanged once. Responses are secrets and are never cacheable.",
        "tags": [
          "Grants"
        ],
        "responses": {
          "200": {
            "description": "The issued relay credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Grant"
                }
              }
            }
          },
          "400": {
            "description": "The request or its signed grant is malformed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The grant assertion failed authentication or validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The signed grant exceeds the consumer's delegation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "412": {
            "description": "The selected operation version is not served",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "A dependency required to decide the request is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_assertion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384,
                    "description": "A compact JWS grant assertion signed by the consumer, with `typ: relay-grant+jwt`."
                  }
                },
                "required": [
                  "grant_assertion"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "x-operation-versions": [
          1
        ]
      }
    }
  },
