{
  "name": "@conservationtv/gatekeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./openapi.json": "./contracts/openapi.json",
    "./testing": "./test/support/testing.ts"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "upload": "cf workers versions create",
    "types": "cf workers types",
    "typecheck": "cf workers types && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "generate": "api-contracts generate",
    "snapshot": "api-contracts snapshot",
    "check:release": "api-contracts check-release",
    "check:snapshot": "api-contracts check-snapshot",
    "snapshot:required": "api-contracts check-snapshot --required",
    "ci:contracts": "api-contracts ci",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "local:up": "docker compose --profile relays up -d --wait",
    "local:down": "docker compose --profile relays down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@arkenv/standard": "catalog:",
    "@conservationtv/store": "workspace:*",
    "@conservationtv/versioned-api": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "@standard-schema/utils": "0.3.0",
    "drizzle-orm": "catalog:",
    "hono": "4.13.8",
    "hono-openapi": "1.3.3",
    "jose": "6.2.12",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.6",
    "@cloudflare/vite-plugin": "beta",
    "@types/node": "24.10.1",
    "@types/pg": "catalog:",
    "cf": "^1.0.0-beta.5",
    "drizzle-kit": "catalog:",
    "miniflare": "5.20261006.0-alpha",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vitest": "5.0.3"
  }
}
