# Copy to .dev.vars for `pnpm dev`. The tokens below are the local environment's, shared with apps/controlplane/local's
# relays and the studio API's .dev.vars.example; only the MoQ signing key set is generated:
# node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign']).then(k=>crypto.subtle.exportKey('jwk',k.privateKey)).then(({kty,crv,x,y,d})=>console.log(JSON.stringify({active_kid:'local-1',keys:[{kty,crv,x,y,d,alg:'ES256',kid:'local-1'}]})))"
MOQ_SIGNING_KEYS='{"active_kid":"…","keys":[…]}'

# The consumer token, which the studio API presents as GATEKEEPER_TOKEN.
CONSUMER_TOKEN=local-consumer-token
# The relays' callback credentials, and MoQ's peer credential (unused with one local relay).
IROH_RELAY_TOKEN=local-iroh-relay-token
MOQ_RELAY_TOKEN=local-moq-relay-token
MOQ_CLUSTER_TOKEN=local-moq-cluster-token

# Optional: endpoint IDs never admitted to the Iroh relay.
# DENIED_IROH_ENDPOINTS='[]'
