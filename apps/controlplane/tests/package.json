    "@number0/iroh": "1.1.0",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.10.1",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "testcontainers": "12.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.3",
    "zod": "catalog:",
    "smol-toml": "1.9.1",
    "@moq-ha/vps-fleet": "workspace:*"
  }
}
