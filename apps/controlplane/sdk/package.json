{
  "name": "@conservationtv/controlplane-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A generated version-aware SDK for the conservation.stream control plane (gatekeeper).",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./versioning": {
      "types": "./dist/versioning.d.ts",
      "import": "./dist/versioning.js"
    },
    "./contracts/*": {
      "types": "./dist/versions/*/sdk.gen.d.ts",
      "import": "./dist/versions/*/sdk.gen.js"
    },
    "./codegen": "./plugins/operation-params.ts",
    "./codegen/operations": "./plugins/operation-versions.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "generate": "openapi-ts --file openapi-ts.config.ts"
  },
  "dependencies": {
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@conservationtv/gatekeeper": "workspace:*",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "24.10.1",
    "@types/pluralize": "0.0.33",
    "pluralize": "8.0.0",
    "typescript": "6.0.3"
  }
}
