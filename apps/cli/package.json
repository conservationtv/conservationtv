{
  "name": "@conservationtv/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "The conservation.tv CLI: signs in, keeps a profile per organisation, and calls the studio API and agents.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conservationtv/conservationtv.git",
    "directory": "apps/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ctv": "./bin/ctv.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "ctv": "./dist/ctv.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "cli": "node bin/ctv.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --external:@number0/iroh --banner:js=\"#!/usr/bin/env node\nimport { createRequire as createBundleRequire } from 'node:module'; const require = createBundleRequire(import.meta.url);\" --outfile=dist/ctv.mjs"
  },
  "dependencies": {
    "@number0/iroh": "catalog:"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@conservationtv/agent-cli": "workspace:*",
    "@conservationtv/agent-sdk": "workspace:*",
    "@conservationtv/store": "workspace:*",
    "@conservationtv/studio-cli": "workspace:*",
    "@conservationtv/studio-sdk": "workspace:*",
    "@strangecyan/iroh-http-node": "catalog:",
    "@types/node": "24.10.1",
    "better-auth": "catalog:",
    "esbuild": "0.28.2",
    "incur": "0.6.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
